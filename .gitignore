# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors
.idea/
.vscode/
*.swp
*~

# Generated model checkpoints are kept locally, not in Git.
*.pt

# Acceptance run artifacts (environment record, checkpoints, predictions,
# figures) are generated by the runbook and are not committed.  The directory
# itself is kept via a sentinel so a fresh clone has somewhere to write.
runs/*
!runs/.gitkeep

# Local tool caches / assistant state
.claude/
.superpowers/
.code-review-graph/
